{
  "expo": {
    "name": "직좌우",
    "slug": "jikjwau",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/app/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "site.kihyuk.jjw",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "site.kihyuk.jjw",
      "adaptiveIcon": {
        "backgroundColor": "#3d9be9",
        "foregroundImage": "./assets/app/adaptive-foreground.png",
        "backgroundImage": "./assets/app/adaptive-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-asset",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "지금 있는 곳을 출발지로 정하려고 위치를 사용해요."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1f99fc",
          "image": "./assets/app/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
