{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/app.ts",
    "start": "tsx --env-file-if-exists=.env src/app.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "osm:download": "tsx scripts/download-osm.ts",
    "osm:tiles": "node --max-old-space-size=6144 --import tsx scripts/build-tiles.ts"
  },
  "dependencies": {
    "@jikjwau/shared": "^0.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "osm-pbf-parser-node": "^1.1.4",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
